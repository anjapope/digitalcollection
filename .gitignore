# Ignore metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore mac files 
.DS_Store

# temporarily ignore gemfile.lock
Gemfile.lock

# Ignore objects directory to avoid committing binary files (other than demo files)
# if you would like to commit your objects to github, delete the line below!
objects/
# Ignore Node secrets and dependencies
.env
node_modules/
/utilities/editorial-workbook/__pycache__/
/outputs/archivory-editorial/preview-*.png
/outputs/archivory-editorial/source.json
/outputs/archivory-editorial/*.inspect.ndjson
# Local, timestamped pre-import CSV backups created by the workbook importer.
# Kept on disk for maintainer recovery; not meant for repo history.
/docs/room-restoration/editorial-backups/
